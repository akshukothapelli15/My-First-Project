# Copy this file to .env.local and add your own private values.
# A PostgreSQL URL from Neon, Supabase, or a local PostgreSQL install.
DATABASE_URL="postgresql://postgres:password@localhost:5432/focusflow?schema=public"
# Optional direct/unpooled database URL (often required for hosted migrations).
DIRECT_URL="postgresql://postgres:password@localhost:5432/focusflow?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Optional. Without this, the assistant uses an honest local, rule-based fallback.
OPENAI_API_KEY=""
# Optional OpenAI model override (default: gpt-4o-mini).
OPENAI_MODEL="gpt-4o-mini"
# Optional: db:seed creates this development account and sample records.
# SEED_EMAIL="student@example.com"
# SEED_PASSWORD="choose-a-strong-development-password"
